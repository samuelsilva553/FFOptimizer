<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginBottom="12dp" android:background="@drawable/card" android:clipToOutline="true" android:foreground="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
    <ImageView android:id="@+id/lBg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:scaleX="3.4" android:scaleY="3.4" android:alpha="0.32"/>
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/list_fade"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
        <ImageView android:id="@+id/lIcon" android:layout_width="66dp" android:layout_height="66dp" android:padding="6dp" android:background="@drawable/tile"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">
            <TextView android:id="@+id/lName" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/text" android:textSize="18sp" android:fontFamily="sans-serif-black"/>
            <TextView android:id="@+id/lVer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#B0B0B0" android:textSize="12sp"/>
        </LinearLayout>
        <ImageView android:layout_width="38dp" android:layout_height="38dp" android:padding="10dp" android:src="@drawable/ic_chevron" android:background="@drawable/icon_btn"/>
    </LinearLayout>
</FrameLayout>
