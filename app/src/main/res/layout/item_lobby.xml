<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="@drawable/card" android:clickable="true" android:focusable="true">
    <ImageView android:id="@+id/lIcon" android:layout_width="64dp" android:layout_height="64dp" android:padding="6dp" android:background="@drawable/tile"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">
        <TextView android:id="@+id/lName" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/text" android:textSize="18sp" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/lVer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/muted" android:textSize="12sp"/>
    </LinearLayout>
    <ImageView android:layout_width="38dp" android:layout_height="38dp" android:padding="10dp" android:src="@drawable/ic_chevron" android:background="@drawable/icon_btn"/>
</LinearLayout>
