<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="12dp" android:paddingBottom="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_fg"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="NEXUS CORNER" android:textColor="@color/text" android:textSize="15sp" android:fontFamily="sans-serif-black" android:letterSpacing="0.08"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="28dp">
            <TextView android:id="@+id/tabGames" style="@style/Tab" android:text="JOGOS"/>
            <TextView android:id="@+id/tabTools" style="@style/Tab" android:text="FERRAMENTAS"/>
            <TextView android:id="@+id/tabInfo" style="@style/Tab" android:text="TERMOS"/>
        </LinearLayout>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <TextView android:id="@+id/tvBatV" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="14dp" android:textColor="@color/text" android:textSize="13sp" android:fontFamily="sans-serif-medium"/>
        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="14dp" android:format12Hour="hh:mm a" android:format24Hour="HH:mm" android:textColor="@color/muted" android:textSize="13sp"/>
        <ImageView android:id="@+id/btnPower" android:layout_width="40dp" android:layout_height="40dp" android:padding="10dp" android:src="@drawable/ic_power" android:background="@drawable/icon_btn" android:contentDescription="Sair"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/panelGames" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="128dp" android:layout_marginTop="14dp" android:scrollbars="none">
                <LinearLayout android:id="@+id/carousel" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical"/>
            </HorizontalScrollView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="bottom" android:layout_marginTop="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tvGame" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/text" android:textSize="24sp" android:fontFamily="sans-serif-black"/>
                    <TextView android:id="@+id/tvPkg" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/muted" android:textSize="11sp"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical">
                        <TextView android:id="@+id/btnStart" android:layout_width="170dp" android:layout_height="46dp" android:gravity="center" android:text="INICIAR" android:textColor="@color/bg" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.2" android:background="@drawable/para_white"/>
                        <ImageView android:id="@+id/btnGrid" android:layout_width="46dp" android:layout_height="46dp" android:layout_marginStart="10dp" android:padding="13dp" android:src="@drawable/ic_grid" android:background="@drawable/icon_btn" android:contentDescription="Perfil do jogo"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/Tile"><TextView style="@style/Label" android:text="TEMPERATURA"/><TextView android:id="@+id/tvTemp" style="@style/TileVal"/><ProgressBar android:id="@+id/pbTemp" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:max="60" android:progressTint="@color/text" android:progressBackgroundTint="@color/line"/></LinearLayout>
                <LinearLayout style="@style/Tile"><TextView style="@style/Label" android:text="RAM EM USO"/><TextView android:id="@+id/tvRam" style="@style/TileVal"/><ProgressBar android:id="@+id/pbRam" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:max="100" android:progressTint="@color/text" android:progressBackgroundTint="@color/line"/></LinearLayout>
                <LinearLayout style="@style/Tile"><TextView style="@style/Label" android:text="VELOCIDADE"/><TextView android:id="@+id/tvCpu" style="@style/TileVal"/><ProgressBar android:id="@+id/pbCpu" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:max="3500" android:progressTint="@color/text" android:progressBackgroundTint="@color/line"/></LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <ScrollView android:id="@+id/panelTools" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:scrollbars="none">
            <LinearLayout style="@style/Card" android:layout_marginTop="14dp">
                <TextView style="@style/Label" android:text="OTIMIZAÇÃO · SHIZUKU"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical">
                    <View android:id="@+id/dotSh" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/dot"/>
                    <TextView android:id="@+id/tvShizuku" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/text" android:textSize="15sp" android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
                <Button android:id="@+id/btnShizuku" style="@style/BtnPrimary" android:layout_marginTop="14dp"/>
                <Button android:id="@+id/btnClean" style="@style/Btn" android:text="Liberar RAM"/>
                <Button android:id="@+id/btnRestore" style="@style/Btn" android:text="Restaurar tela padrão"/>
                <Switch android:id="@+id/swHud" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:text="Monitor dentro do jogo" android:textColor="@color/text" android:textSize="14sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><CheckBox android:id="@+id/cbCpu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CPU" android:textColor="@color/text" android:textSize="12sp" android:buttonTint="@color/text"/><CheckBox android:id="@+id/cbRam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="RAM" android:textColor="@color/text" android:textSize="12sp" android:buttonTint="@color/text"/><CheckBox android:id="@+id/cbTemp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Temp." android:textColor="@color/text" android:textSize="12sp" android:buttonTint="@color/text"/><CheckBox android:id="@+id/cbFps" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="FPS" android:textColor="@color/text" android:textSize="12sp" android:buttonTint="@color/text"/><CheckBox android:id="@+id/cbClock" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Hora" android:textColor="@color/text" android:textSize="12sp" android:buttonTint="@color/text"/></LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Ao jogar, um botão flutuante abre atalhos: não perturbar, travar rotação e brilho, mostrar toques, screenshot e liberar RAM. Tudo volta ao normal quando o monitor fecha." android:textColor="@color/muted" android:textSize="11sp"/>
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:id="@+id/panelInfo" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nexus Corner" android:textColor="@color/text" android:textSize="22sp" android:fontFamily="sans-serif-black"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Versão 1.5.0 · app independente" android:textColor="@color/muted" android:textSize="12sp"/>
            <Button android:id="@+id/btnTerms" style="@style/Btn" android:layout_width="320dp" android:layout_marginTop="18dp" android:text="Termos, privacidade e direitos autorais"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
