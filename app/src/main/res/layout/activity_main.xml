<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView style="@style/Label" android:layout_marginTop="16dp" android:text="NEXUS CORNER"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/headline" android:textColor="@color/text" android:textSize="30sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
    <LinearLayout style="@style/Card" android:layout_marginTop="24dp">
        <TextView style="@style/Label" android:text="MEMÓRIA"/>
        <TextView android:id="@+id/tvRam" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
        <ProgressBar android:id="@+id/pbRam" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="12dp" android:progressTint="@color/accent" android:progressBackgroundTint="@color/line"/>
        <TextView android:id="@+id/tvStorage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="13sp" android:layout_marginTop="12dp"/>
    </LinearLayout>
    <LinearLayout style="@style/Card">
        <TextView style="@style/Label" android:text="JOGO"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <TextView android:id="@+id/chipFf" style="@style/Chip" android:text="Free Fire"/>
            <TextView android:id="@+id/chipMax" style="@style/Chip" android:text="Free Fire MAX" android:layout_marginEnd="0dp"/>
        </LinearLayout>
        <Button android:id="@+id/btnLaunch" style="@style/BtnPrimary" android:text="Abrir jogo"/>
        <Button android:id="@+id/btnData" style="@style/Btn" android:text="Armazenamento e cache do jogo"/>
    </LinearLayout>
    <LinearLayout style="@style/Card">
        <TextView style="@style/Label" android:text="TELA"/>
        <TextView android:id="@+id/tvScreen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="15sp" android:layout_marginTop="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <EditText android:id="@+id/etW" style="@style/Input" android:hint="Largura" android:text="1080" android:textColorHint="@color/muted"/>
            <EditText android:id="@+id/etH" style="@style/Input" android:hint="Altura" android:text="2400" android:textColorHint="@color/muted"/>
            <EditText android:id="@+id/etD" style="@style/Input" android:hint="DPI" android:text="420" android:textColorHint="@color/muted" android:layout_marginEnd="0dp"/>
        </LinearLayout>
        <Button android:id="@+id/btnCopy" style="@style/BtnPrimary" android:text="Copiar comando"/>
        <Button android:id="@+id/btnReset" style="@style/Btn" android:text="Copiar comando de restauração"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/screen_note" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="12dp"/>
    </LinearLayout>
    <TextView android:id="@+id/tvLegal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" android:text="Termos, privacidade e direitos autorais" android:textColor="@color/muted" android:textSize="13sp"/>
</LinearLayout>
</ScrollView>
