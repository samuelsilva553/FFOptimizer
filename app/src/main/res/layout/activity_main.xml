<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
<LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/Label" android:text="NEXUS CORNER"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Game Space" android:textColor="@color/text" android:textSize="30sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp"/>
        </LinearLayout>
        <ImageView android:id="@+id/btnInfo" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:src="@drawable/ic_info" android:background="@drawable/icon_btn" android:contentDescription="Termos"/>
    </LinearLayout>
    <LinearLayout style="@style/Card" android:orientation="horizontal" android:layout_marginTop="24dp"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/Label" android:text="RAM"/><TextView android:id="@+id/tvRamV" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp"/></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/Label" android:text="BATERIA"/><TextView android:id="@+id/tvBatV" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp"/></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/Label" android:text="TEMP."/><TextView android:id="@+id/tvTempV" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp"/></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/Label" android:text="LIVRE"/><TextView android:id="@+id/tvStoV" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp"/></LinearLayout></LinearLayout>
    <LinearLayout style="@style/Card">
        <TextView style="@style/Label" android:text="BIBLIOTECA"/>
        <GridLayout android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="3" android:layout_marginTop="12dp"/>
    </LinearLayout>
    <LinearLayout style="@style/Card">
        <TextView style="@style/Label" android:text="OTIMIZAÇÃO · SHIZUKU"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical">
            <View android:id="@+id/dotSh" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/dot"/>
            <TextView android:id="@+id/tvShizuku" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/text" android:textSize="15sp" android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <Button android:id="@+id/btnShizuku" style="@style/BtnPrimary" android:layout_marginTop="14dp"/>
        <Button android:id="@+id/btnClean" style="@style/Btn" android:text="Liberar RAM"/>
        <Button android:id="@+id/btnRestore" style="@style/Btn" android:text="Restaurar tela padrão"/>
    </LinearLayout>
    <TextView android:id="@+id/tvLegal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" android:text="Termos, privacidade e direitos autorais" android:textColor="@color/muted" android:textSize="12sp"/>
</LinearLayout>
</ScrollView>