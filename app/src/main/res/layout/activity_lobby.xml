<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="40dp" android:paddingBottom="120dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lobby" android:textColor="@color/text" android:textSize="36sp" android:fontFamily="sans-serif-black"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nexus Corner · Game Space" android:textColor="@color/muted" android:textSize="14sp"/>
                </LinearLayout>
                <TextView android:id="@+id/tvBat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/pill_dark" android:textColor="@color/text" android:textSize="13sp" android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/hero_card">
                <ImageView android:layout_width="220dp" android:layout_height="220dp" android:layout_gravity="end|top" android:src="@drawable/ic_fg" android:alpha="0.10"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEXUS" android:textColor="@color/muted" android:textSize="16sp" android:letterSpacing="0.2"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CORNER" android:textColor="@color/text" android:textSize="38sp" android:fontFamily="sans-serif-black"/>
                    <TextView android:id="@+id/tvVer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="12sp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/Label" android:text="RAM EM USO"/>
                            <TextView android:id="@+id/tvRam" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/text" android:textSize="30sp" android:fontFamily="sans-serif-black"/>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/btnSpace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="24dp" android:paddingEnd="20dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:background="@drawable/pill_white" android:clickable="true" android:focusable="true">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jogo" android:textColor="@color/bg" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Space" android:textColor="@color/bg" android:textSize="22sp" android:fontFamily="sans-serif-black"/>
                            </LinearLayout>
                            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="18dp" android:src="@drawable/ic_rocket" android:tint="@color/bg"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:gravity="center_vertical">
                <View android:layout_width="4dp" android:layout_height="22dp" android:background="@color/text"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Biblioteca de jogos" android:textColor="@color/text" android:textSize="18sp" android:fontFamily="sans-serif-medium"/>
                <TextView android:id="@+id/tvCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/muted" android:textSize="14sp"/>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                <LinearLayout android:id="@+id/btnAdd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/pill_dark" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Adicionar jogos" android:textColor="@color/text" android:textSize="13sp" android:fontFamily="sans-serif-medium"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="+" android:textColor="@color/text" android:textSize="18sp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical"/>
            <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" android:text="Nenhum jogo ainda. Toque em Adicionar jogos." android:textColor="@color/muted" android:textSize="14sp" android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="28dp" android:padding="8dp" android:gravity="center_vertical" android:background="@drawable/nav_bg">
        <ImageView android:id="@+id/btnNavInfo" android:layout_width="52dp" android:layout_height="52dp" android:padding="14dp" android:src="@drawable/ic_info" android:contentDescription="Termos"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:gravity="center_vertical" android:paddingStart="22dp" android:paddingEnd="24dp" android:paddingTop="13dp" android:paddingBottom="13dp" android:background="@drawable/pill_white">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_gamepad" android:tint="@color/bg"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Lobby" android:textColor="@color/bg" android:textSize="16sp" android:fontFamily="sans-serif-black"/>
        </LinearLayout>
        <ImageView android:id="@+id/btnNavTools" android:layout_width="52dp" android:layout_height="52dp" android:padding="14dp" android:src="@drawable/ic_flask" android:contentDescription="Ferramentas"/>
    </LinearLayout>
</FrameLayout>
