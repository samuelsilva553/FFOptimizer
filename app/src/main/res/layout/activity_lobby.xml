<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lobby" android:textColor="@color/text" android:textSize="28sp" android:fontFamily="sans-serif-black"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nexus Corner" android:textColor="@color/muted" android:textSize="13sp"/>
        </LinearLayout>
        <ImageView android:id="@+id/btnTools" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:padding="11dp" android:src="@drawable/ic_flask" android:background="@drawable/icon_btn" android:contentDescription="Ferramentas"/><ImageView android:id="@+id/btnInfo" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:padding="11dp" android:src="@drawable/ic_info" android:background="@drawable/icon_btn" android:contentDescription="Termos"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/hero_card">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="16dp" android:paddingBottom="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEXUS" android:textColor="@color/muted" android:textSize="12sp" android:letterSpacing="0.3"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CORNER" android:textColor="@color/text" android:textSize="32sp" android:fontFamily="sans-serif-black"/>
                <TextView android:id="@+id/tvVer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="14dp" android:background="@drawable/hero_band">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="20dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RAM" android:textColor="@color/muted" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.15"/><TextView android:id="@+id/tvRam" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="19sp" android:fontFamily="sans-serif-black"/></LinearLayout><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="20dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TEMP." android:textColor="@color/muted" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.15"/><TextView android:id="@+id/tvTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="19sp" android:fontFamily="sans-serif-black"/></LinearLayout>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                <LinearLayout android:id="@+id/btnSpace" android:layout_width="wrap_content" android:layout_height="44dp" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="20dp" android:background="@drawable/pill_white" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_play" android:tint="@color/bg"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="GAME SPACE" android:textColor="@color/bg" android:textSize="13sp" android:fontFamily="sans-serif-black" android:letterSpacing="0.08"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="10dp" android:gravity="center_vertical">
        <View android:layout_width="3dp" android:layout_height="18dp" android:background="@color/text"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:text="Biblioteca" android:textColor="@color/text" android:textSize="16sp" android:fontFamily="sans-serif-black"/>
        <TextView android:id="@+id/tvCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/muted" android:textSize="13sp"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <LinearLayout android:id="@+id/btnAdd" android:layout_width="wrap_content" android:layout_height="34dp" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="12dp" android:background="@drawable/pill_dark" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Adicionar" android:textColor="@color/text" android:textSize="12sp" android:fontFamily="sans-serif-medium"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="+" android:textColor="@color/text" android:textSize="16sp"/>
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" android:text="Nenhum jogo ainda. Toque em Adicionar." android:textColor="@color/muted" android:textSize="13sp" android:visibility="gone"/>
            <TextView android:id="@+id/tvFooter" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="20dp" android:textColor="@color/muted" android:textSize="11sp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
