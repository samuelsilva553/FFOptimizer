<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="38dp" android:paddingBottom="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxHeight="64dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:src="@drawable/logo"/>
        <ImageView android:id="@+id/btnInfo" android:layout_width="46dp" android:layout_height="46dp" android:layout_marginStart="16dp" android:padding="12dp" android:src="@drawable/ic_info" android:background="@drawable/icon_btn" android:contentDescription="Termos"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical" android:padding="22dp" android:background="@drawable/hero_card">
        <TextView style="@style/Label" android:text="GAME SPACE" android:letterSpacing="0.25"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Pronto para jogar" android:textColor="@color/text" android:textSize="28sp" android:fontFamily="sans-serif-black"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Perfil por jogo, monitor em tempo real e atalhos." android:textColor="@color/muted" android:textSize="13sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center_vertical"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/Label" android:text="RAM EM USO"/><TextView android:id="@+id/tvRam" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text" android:textSize="26sp" android:fontFamily="sans-serif-black"/></LinearLayout><View android:layout_width="1dp" android:layout_height="40dp" android:layout_marginEnd="18dp" android:background="#2E2E2E"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/Label" android:text="BATERIA"/><TextView android:id="@+id/tvBat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text" android:textSize="26sp" android:fontFamily="sans-serif-black"/></LinearLayout><View android:layout_width="1dp" android:layout_height="40dp" android:layout_marginEnd="18dp" android:background="#2E2E2E"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/Label" android:text="TEMP."/><TextView android:id="@+id/tvTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text" android:textSize="26sp" android:fontFamily="sans-serif-black"/></LinearLayout></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/btnSpace" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:gravity="center" android:background="@drawable/pill_white" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_play" android:tint="@color/bg"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="GAME SPACE" android:textColor="@color/bg" android:textSize="15sp" android:fontFamily="sans-serif-black" android:letterSpacing="0.15"/>
            </LinearLayout>
            <ImageView android:id="@+id/btnTools" android:layout_width="58dp" android:layout_height="58dp" android:layout_marginStart="12dp" android:padding="17dp" android:src="@drawable/ic_flask" android:background="@drawable/icon_btn" android:contentDescription="Ferramentas"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:gravity="center_vertical">
        <View android:layout_width="4dp" android:layout_height="22dp" android:background="@color/text"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Biblioteca" android:textColor="@color/text" android:textSize="20sp" android:fontFamily="sans-serif-black"/>
        <TextView android:id="@+id/tvCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/muted" android:textSize="14sp"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <LinearLayout android:id="@+id/btnAdd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/pill_dark" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Adicionar" android:textColor="@color/text" android:textSize="13sp" android:fontFamily="sans-serif-medium"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="+" android:textColor="@color/text" android:textSize="18sp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical"/>
    <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" android:text="Nenhum jogo ainda. Toque em Adicionar." android:textColor="@color/muted" android:textSize="14sp" android:visibility="gone"/>
    <TextView android:id="@+id/tvFooter" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" android:textColor="@color/muted" android:textSize="12sp"/>
</LinearLayout>
</ScrollView>
